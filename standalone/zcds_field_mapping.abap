CLASS lcl_mapping DEFINITION FINAL.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

    TYPES: BEGIN OF ts_field_map,
             cds_field   TYPE string,
             table_field TYPE string,
             computed    TYPE abap_bool,
             expression  TYPE string,
             defined_in  TYPE string,
           END OF ts_field_map,
           tt_field_map TYPE STANDARD TABLE OF ts_field_map WITH EMPTY KEY.

    TYPES: BEGIN OF ts_view_map,
             cds_name   TYPE string,
             table_name TYPE string,
             released   TYPE abap_bool,
             mapping    TYPE tt_field_map,
           END OF ts_view_map,
           tt_view_map TYPE STANDARD TABLE OF ts_view_map WITH EMPTY KEY.

    METHODS extract
      IMPORTING it_pairs         TYPE lcl_pairs=>tt_pair
      RETURNING VALUE(rt_result) TYPE tt_view_map.

    METHODS to_json
      IMPORTING it_result      TYPE tt_view_map
      RETURNING VALUE(rv_json) TYPE string.

    METHODS get_errors
      RETURNING VALUE(rt_errors) TYPE string_table.

  PRIVATE SECTION.
    CONSTANTS c_max_depth TYPE i VALUE 10.

    TYPES: BEGIN OF ts_source,
             alias  TYPE string,
             entity TYPE string,
           END OF ts_source,
           tt_source TYPE SORTED TABLE OF ts_source WITH UNIQUE KEY alias.

    TYPES: BEGIN OF ts_origin,
             entity TYPE string,
             field  TYPE string,
           END OF ts_origin,
           tt_origin TYPE STANDARD TABLE OF ts_origin WITH EMPTY KEY.

    TYPES: BEGIN OF ts_column,
             field         TYPE string,
             name          TYPE string,
             source_entity TYPE string,
             source_field  TYPE string,
             origins       TYPE tt_origin,
             computed      TYPE tt_origin,
             expression    TYPE string,
           END OF ts_column,
           tt_column TYPE SORTED TABLE OF ts_column WITH UNIQUE KEY field.

    TYPES: BEGIN OF ts_view,
             name    TYPE string,
             found   TYPE abap_bool,
             columns TYPE tt_column,
           END OF ts_view,
           tt_view TYPE HASHED TABLE OF ts_view WITH UNIQUE KEY name.

    TYPES: BEGIN OF ts_name,
             upper    TYPE string,
             original TYPE string,
           END OF ts_name,
           tt_name TYPE HASHED TABLE OF ts_name WITH UNIQUE KEY upper.

    TYPES: BEGIN OF ts_candidate,
             field     TYPE fieldname,
             tabname   TYPE tabname,
             fieldname TYPE fieldname,
           END OF ts_candidate,
           tt_candidate TYPE STANDARD TABLE OF ts_candidate WITH EMPTY KEY.

    TYPES: BEGIN OF ts_read,
             field      TYPE string,
             expression TYPE string,
             defined_in TYPE string,
           END OF ts_read,
           tt_read TYPE STANDARD TABLE OF ts_read WITH EMPTY KEY.

    TYPES: BEGIN OF ts_table,
             name    TYPE tabname,
             columns TYPE SORTED TABLE OF fieldname WITH NON-UNIQUE KEY table_line,
           END OF ts_table,
           tt_table TYPE HASHED TABLE OF ts_table WITH UNIQUE KEY name.

    DATA mt_views  TYPE tt_view.
    DATA mt_tables TYPE tt_table.
    DATA mt_errors TYPE string_table.

    METHODS read_view
      IMPORTING iv_name        TYPE string
      RETURNING VALUE(rs_view) TYPE ts_view.

    METHODS read_view_dictionary
      IMPORTING iv_name        TYPE string
      RETURNING VALUE(rs_view) TYPE ts_view.

    METHODS read_view_xco
      IMPORTING iv_name        TYPE string
      RETURNING VALUE(rs_view) TYPE ts_view.

    METHODS field_names
      IMPORTING iv_name         TYPE string
      RETURNING VALUE(rt_names) TYPE tt_name.

    METHODS trace_field
      IMPORTING iv_view               TYPE string
                iv_field              TYPE string
                iv_table              TYPE string
                iv_depth              TYPE i DEFAULT 0
      RETURNING VALUE(rv_table_field) TYPE string.

    METHODS trace_computed
      IMPORTING iv_view          TYPE string
                iv_field         TYPE string
                iv_table         TYPE string
                iv_depth         TYPE i DEFAULT 0
      RETURNING VALUE(rt_fields) TYPE tt_read.

    METHODS table_has_column
      IMPORTING iv_table       TYPE string
                iv_field       TYPE string
      RETURNING VALUE(rv_found) TYPE abap_bool.

    METHODS parse_references
      IMPORTING iv_expression  TYPE string
                it_sources     TYPE tt_source
                iv_main        TYPE string
      RETURNING VALUE(rt_refs) TYPE tt_origin.

    METHODS parse_data_source
      IMPORTING io_source        TYPE REF TO if_xco_ddl_expr_data_source
      RETURNING VALUE(rs_source) TYPE ts_source.

    METHODS sources_from_ddl
      IMPORTING iv_name           TYPE string
      EXPORTING ev_main           TYPE string
      RETURNING VALUE(rt_sources) TYPE tt_source.

    METHODS display_name
      IMPORTING iv_name        TYPE string
                iv_alias       TYPE string
                iv_expression  TYPE string
      RETURNING VALUE(rv_name) TYPE string.

    METHODS parse_column
      IMPORTING iv_expression    TYPE string
                it_sources       TYPE tt_source
                iv_main          TYPE string
      RETURNING VALUE(rs_column) TYPE ts_column.

    METHODS expression_text
      IMPORTING io_expression  TYPE REF TO if_xco_ddl_expression
      RETURNING VALUE(rv_text) TYPE string.
ENDCLASS.


CLASS lcl_mapping IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    DATA(lt_result) = extract( lcl_pairs=>get( ) ).
    out->write( to_json( lt_result ) ).
    IF mt_errors IS NOT INITIAL.
      out->write( `---ERRORS---` ).
      out->write( mt_errors ).
    ENDIF.
  ENDMETHOD.


  METHOD extract.
    LOOP AT it_pairs INTO DATA(ls_pair).
      DATA(lv_cds) = to_upper( ls_pair-cds_name ).
      DATA(lv_table) = to_upper( ls_pair-table_name ).
      DATA(ls_view) = read_view( lv_cds ).
      IF ls_view-found = abap_false.
        INSERT |NOT_FOUND: { lv_cds }| INTO TABLE mt_errors.
        CONTINUE.
      ENDIF.

      INSERT VALUE #( cds_name   = lv_cds
                      table_name = lv_table
                      released   = ls_pair-released )
             INTO TABLE rt_result REFERENCE INTO DATA(lr_result).

      LOOP AT ls_view-columns INTO DATA(ls_column).
        DATA(lv_direct) = trace_field( iv_view  = lv_cds
                                       iv_field = ls_column-field
                                       iv_table = lv_table ).
        DATA(lt_read) = COND tt_read( WHEN lv_direct IS INITIAL
                                      THEN trace_computed( iv_view  = lv_cds
                                                           iv_field = ls_column-field
                                                           iv_table = lv_table ) ).
        IF lt_read IS INITIAL.
          INSERT VALUE #( cds_field = ls_column-name table_field = lv_direct ) INTO TABLE lr_result->mapping.
          CONTINUE.
        ENDIF.

        LOOP AT lt_read INTO DATA(ls_read).
          INSERT VALUE #( cds_field   = ls_column-name
                          table_field = ls_read-field
                          computed    = abap_true
                          expression  = ls_read-expression
                          defined_in  = ls_read-defined_in )
                 INTO TABLE lr_result->mapping.
        ENDLOOP.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD to_json.
    rv_json = /ui2/cl_json=>serialize( data        = it_result
                                       pretty_name = /ui2/cl_json=>pretty_mode-camel_case ).
  ENDMETHOD.


  METHOD get_errors.
    rt_errors = mt_errors.
  ENDMETHOD.


  METHOD read_view.
    READ TABLE mt_views INTO rs_view WITH TABLE KEY name = iv_name.
    IF sy-subrc = 0.
      RETURN.
    ENDIF.

    rs_view = read_view_dictionary( iv_name ).
    IF rs_view-found = abap_false.
      rs_view = read_view_xco( iv_name ).
    ENDIF.
    rs_view-name = iv_name.
    INSERT rs_view INTO TABLE mt_views.
  ENDMETHOD.


  METHOD read_view_dictionary.
    DATA(lv_ddl_name) = iv_name.
    SELECT SINGLE FROM ddldependency
      FIELDS objectname
      WHERE ddlname = @iv_name
        AND objecttype = 'VIEW'
        AND state = 'A'
      INTO @DATA(lv_sql_view).
    IF sy-subrc <> 0.
      lv_sql_view = iv_name.
      SELECT SINGLE FROM ddldependency
        FIELDS ddlname
        WHERE objectname = @iv_name
          AND objecttype = 'VIEW'
          AND state = 'A'
        INTO @DATA(lv_owner_ddl).
      lv_ddl_name = COND #( WHEN sy-subrc = 0 THEN CONV string( lv_owner_ddl ) ).
    ENDIF.

    SELECT FROM dd27s
      FIELDS objpos, viewfield, tabname, fieldname
      WHERE viewname = @lv_sql_view
        AND as4local = 'A'
      ORDER BY objpos
      INTO TABLE @DATA(lt_fields).
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    rs_view-found = abap_true.
    DATA(lt_names) = field_names( iv_name ).
    DATA(lt_computed) = VALUE string_table( ).

    LOOP AT lt_fields INTO DATA(ls_field).
      IF ls_field-viewfield CP '.*' OR ls_field-viewfield = 'MANDT'.
        CONTINUE.
      ENDIF.

      DATA(lv_field) = CONV string( ls_field-viewfield ).
      READ TABLE rs_view-columns ASSIGNING FIELD-SYMBOL(<ls_field_column>) WITH TABLE KEY field = lv_field.
      IF sy-subrc <> 0.
        INSERT VALUE #( field = lv_field
                        name  = VALUE #( lt_names[ upper = lv_field ]-original DEFAULT lv_field ) )
               INTO TABLE rs_view-columns ASSIGNING <ls_field_column>.
      ENDIF.

      IF ls_field-tabname NP 'DDDDL*TYPES'.
        INSERT VALUE #( entity = ls_field-tabname field = ls_field-fieldname ) INTO TABLE <ls_field_column>-origins.
      ELSE.
        INSERT lv_field INTO TABLE lt_computed.
      ENDIF.
    ENDLOOP.

    IF lt_computed IS INITIAL OR lv_ddl_name IS INITIAL.
      RETURN.
    ENDIF.
    SORT lt_computed.
    DELETE ADJACENT DUPLICATES FROM lt_computed.

    DATA(ls_parsed) = read_view_xco( lv_ddl_name ).
    DATA(lt_candidates) = VALUE tt_candidate( ).
    LOOP AT lt_computed INTO DATA(lv_computed).
      READ TABLE ls_parsed-columns INTO DATA(ls_parsed_column) WITH TABLE KEY field = lv_computed.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.
      IF ls_parsed_column-source_entity IS NOT INITIAL.
        INSERT VALUE #( field     = lv_computed
                        tabname   = ls_parsed_column-source_entity
                        fieldname = ls_parsed_column-source_field ) INTO TABLE lt_candidates.
      ELSE.
        READ TABLE rs_view-columns ASSIGNING FIELD-SYMBOL(<ls_computed>) WITH TABLE KEY field = lv_computed.
        <ls_computed>-computed = ls_parsed_column-computed.
        <ls_computed>-expression = ls_parsed_column-expression.
      ENDIF.
    ENDLOOP.
    IF lt_candidates IS INITIAL.
      RETURN.
    ENDIF.

    SELECT FROM @lt_candidates AS cand
      INNER JOIN dd03l AS col
        ON  col~tabname   = cand~tabname
        AND col~fieldname = cand~fieldname
      FIELDS cand~field, cand~tabname, cand~fieldname
      WHERE col~as4local = 'A'
      INTO TABLE @DATA(lt_confirmed).

    LOOP AT lt_candidates INTO DATA(ls_candidate).
      IF line_exists( lt_confirmed[ field = ls_candidate-field ] ).
        CONTINUE.
      ENDIF.
      DATA(ls_source_view) = read_view( CONV #( ls_candidate-tabname ) ).
      IF line_exists( ls_source_view-columns[ field = CONV string( ls_candidate-fieldname ) ] ).
        INSERT ls_candidate INTO TABLE lt_confirmed.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_confirmed INTO DATA(ls_confirmed).
      READ TABLE rs_view-columns ASSIGNING FIELD-SYMBOL(<ls_column>) WITH TABLE KEY field = CONV string( ls_confirmed-field ).
      IF sy-subrc = 0.
        INSERT VALUE #( entity = ls_confirmed-tabname field = ls_confirmed-fieldname ) INTO TABLE <ls_column>-origins.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD field_names.
    SELECT SINGLE FROM ddddlsrc
      FIELDS source
      WHERE ddlname = @iv_name
        AND as4local = 'A'
      INTO @DATA(lv_source).
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    REPLACE ALL OCCURRENCES OF PCRE `//[^\n]*` IN lv_source WITH ``.
    REPLACE ALL OCCURRENCES OF PCRE `(?s)/\*.*?\*/` IN lv_source WITH ``.

    FIND ALL OCCURRENCES OF PCRE `(?i)\bas\s+([A-Za-z_][A-Za-z0-9_]*)\b(?!\s*(?:\)|preserving\b))` IN lv_source RESULTS DATA(lt_aliases).
    FIND ALL OCCURRENCES OF PCRE `([A-Za-z_][A-Za-z0-9_]*)\s*[,}]` IN lv_source RESULTS DATA(lt_plain).
    INSERT LINES OF lt_plain INTO TABLE lt_aliases.

    LOOP AT lt_aliases INTO DATA(ls_match).
      DATA(lv_token) = substring( val = lv_source
                                  off = ls_match-submatches[ 1 ]-offset
                                  len = ls_match-submatches[ 1 ]-length ).
      INSERT VALUE #( upper = to_upper( lv_token ) original = lv_token ) INTO TABLE rt_names.
    ENDLOOP.
  ENDMETHOD.


  METHOD read_view_xco.
    DATA lv_main  TYPE string.
    DATA lv_alias TYPE string.
    DATA lt_joins TYPE sxco_t_ddl_expr_data_sources.
    DATA lt_fields TYPE sxco_t_cds_fields.

    TRY.
        DATA(lo_view) = xco_cds=>view( CONV #( iv_name ) ).
        DATA(lo_entity) = xco_cds=>view_entity( CONV #( iv_name ) ).
        IF lo_view->exists( ).
          lt_fields = lo_view->fields->all->get( ).
          rs_view-found = abap_true.
        ELSEIF lo_entity->exists( ).
          lt_fields = lo_entity->fields->all->get( ).
          rs_view-found = abap_true.
        ENDIF.
      CATCH cx_root INTO DATA(lx_error).
        INSERT |READ_ERROR: { iv_name }: { lx_error->get_text( ) }| INTO TABLE mt_errors.
        CLEAR rs_view-found.
    ENDTRY.

    IF rs_view-found = abap_false.
      RETURN.
    ENDIF.

    TRY.
        IF lo_view->exists( ).
          DATA(ls_view_source) = lo_view->content( )->get_data_source( ).
          lv_main = ls_view_source-entity.
          lv_alias = ls_view_source-alias.
          INSERT LINES OF ls_view_source-inner_joins INTO TABLE lt_joins.
          INSERT LINES OF ls_view_source-left_outer_joins INTO TABLE lt_joins.
          INSERT LINES OF ls_view_source-right_outer_joins INTO TABLE lt_joins.
        ELSE.
          DATA(ls_entity_source) = lo_entity->content( )->get_data_source( ).
          lv_main = ls_entity_source-view_entity.
          lv_alias = ls_entity_source-alias.
          INSERT LINES OF ls_entity_source-inner_joins INTO TABLE lt_joins.
          INSERT LINES OF ls_entity_source-left_outer_joins INTO TABLE lt_joins.
          INSERT LINES OF ls_entity_source-right_outer_joins INTO TABLE lt_joins.
        ENDIF.
      CATCH cx_root.
        CLEAR: lv_main, lv_alias, lt_joins.
    ENDTRY.

    DATA(lt_sources) = VALUE tt_source( ).
    IF lv_main IS INITIAL.
      lt_sources = sources_from_ddl( EXPORTING iv_name = iv_name
                                     IMPORTING ev_main = lv_main ).
      IF lv_main IS INITIAL.
        INSERT |SOURCE_UNKNOWN: { iv_name }| INTO TABLE mt_errors.
      ENDIF.
    ELSE.
      lv_main = to_upper( lv_main ).
      INSERT VALUE #( alias = lv_main entity = lv_main ) INTO TABLE lt_sources.
      IF lv_alias IS NOT INITIAL.
        INSERT VALUE #( alias = to_upper( lv_alias ) entity = lv_main ) INTO TABLE lt_sources.
      ENDIF.

      LOOP AT lt_joins INTO DATA(lo_join).
        DATA(ls_join_source) = parse_data_source( lo_join ).
        IF ls_join_source-entity IS INITIAL.
          CONTINUE.
        ENDIF.
        INSERT VALUE #( alias = ls_join_source-entity entity = ls_join_source-entity ) INTO TABLE lt_sources.
        IF ls_join_source-alias IS NOT INITIAL.
          INSERT ls_join_source INTO TABLE lt_sources.
        ENDIF.
      ENDLOOP.
    ENDIF.

    LOOP AT lt_fields INTO DATA(lo_field).
      IF lo_field->name CP `_*`.
        CONTINUE.
      ENDIF.

      DATA(lv_expression) = VALUE string( ).
      DATA(lv_field_alias) = VALUE string( ).
      TRY.
          DATA(lo_field_content) = lo_field->content( ).
          lv_expression = expression_text( lo_field_content->get_expression( ) ).
          lv_field_alias = lo_field_content->get_alias( ).
        CATCH cx_root.
          CLEAR: lv_expression, lv_field_alias.
      ENDTRY.

      DATA(ls_column) = parse_column( iv_expression = lv_expression
                                      it_sources    = lt_sources
                                      iv_main       = lv_main ).
      IF ls_column-source_entity IS INITIAL.
        ls_column-computed = parse_references( iv_expression = lv_expression
                                               it_sources    = lt_sources
                                               iv_main       = lv_main ).
        ls_column-expression = lv_expression.
      ENDIF.
      ls_column-field = to_upper( lo_field->name ).
      ls_column-name = display_name( iv_name       = ls_column-field
                                     iv_alias      = lv_field_alias
                                     iv_expression = lv_expression ).
      INSERT ls_column INTO TABLE rs_view-columns.
    ENDLOOP.
  ENDMETHOD.


  METHOD display_name.
    rv_name = iv_name.
    IF iv_alias IS NOT INITIAL AND to_upper( iv_alias ) = iv_name.
      rv_name = iv_alias.
      RETURN.
    ENDIF.

    FIND FIRST OCCURRENCE OF PCRE `([A-Za-z0-9_/$]+)\s*$` IN condense( iv_expression ) SUBMATCHES DATA(lv_last_token).
    IF sy-subrc = 0 AND to_upper( lv_last_token ) = iv_name.
      rv_name = lv_last_token.
    ENDIF.
  ENDMETHOD.


  METHOD sources_from_ddl.
    SELECT SINGLE FROM ddddlsrc
      FIELDS source
      WHERE ddlname = @iv_name
        AND as4local = 'A'
      INTO @DATA(lv_source).
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lv_source = to_upper( lv_source ).
    REPLACE ALL OCCURRENCES OF PCRE `//[^\n]*` IN lv_source WITH ``.
    REPLACE ALL OCCURRENCES OF PCRE `(?s)/\*.*?\*/` IN lv_source WITH ``.

    FIND ALL OCCURRENCES OF PCRE `\b(FROM|JOIN)\s+([A-Z0-9_/]+)(?:\s*\([^)]*\))?(?:\s+AS\s+([A-Z0-9_/]+))?`
         IN lv_source RESULTS DATA(lt_matches).

    LOOP AT lt_matches INTO DATA(ls_match).
      DATA(lv_keyword) = substring( val = lv_source
                                    off = ls_match-submatches[ 1 ]-offset
                                    len = ls_match-submatches[ 1 ]-length ).
      DATA(lv_entity) = substring( val = lv_source
                                   off = ls_match-submatches[ 2 ]-offset
                                   len = ls_match-submatches[ 2 ]-length ).
      DATA(ls_alias_match) = ls_match-submatches[ 3 ].
      DATA(lv_alias) = COND string( WHEN ls_alias_match-offset >= 0 AND ls_alias_match-length > 0
                                    THEN substring( val = lv_source
                                                    off = ls_alias_match-offset
                                                    len = ls_alias_match-length ) ).

      IF lv_keyword = `FROM` AND ev_main IS INITIAL.
        ev_main = lv_entity.
      ENDIF.
      INSERT VALUE #( alias = lv_entity entity = lv_entity ) INTO TABLE rt_sources.
      IF lv_alias IS NOT INITIAL.
        INSERT VALUE #( alias = lv_alias entity = lv_entity ) INTO TABLE rt_sources.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD trace_field.
    IF iv_depth > c_max_depth.
      RETURN.
    ENDIF.

    DATA(ls_view) = read_view( iv_view ).
    READ TABLE ls_view-columns INTO DATA(ls_column) WITH TABLE KEY field = iv_field.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    DATA(lt_origins) = ls_column-origins.
    IF ls_column-source_entity IS NOT INITIAL.
      INSERT VALUE #( entity = ls_column-source_entity field = ls_column-source_field ) INTO TABLE lt_origins.
    ENDIF.

    rv_table_field = VALUE #( lt_origins[ entity = iv_table ]-field OPTIONAL ).
    IF rv_table_field IS NOT INITIAL.
      RETURN.
    ENDIF.

    LOOP AT lt_origins INTO DATA(ls_origin).
      IF read_view( ls_origin-entity )-found = abap_false.
        CONTINUE.
      ENDIF.
      rv_table_field = trace_field( iv_view  = ls_origin-entity
                                    iv_field = ls_origin-field
                                    iv_table = iv_table
                                    iv_depth = iv_depth + 1 ).
      IF rv_table_field IS NOT INITIAL.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD trace_computed.
    IF iv_depth > c_max_depth.
      RETURN.
    ENDIF.

    DATA(ls_view) = read_view( iv_view ).
    READ TABLE ls_view-columns INTO DATA(ls_column) WITH TABLE KEY field = iv_field.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    LOOP AT ls_column-computed INTO DATA(ls_reference).
      IF ls_reference-entity = iv_table.
        IF table_has_column( iv_table = iv_table iv_field = ls_reference-field ) = abap_true.
          INSERT VALUE #( field      = ls_reference-field
                          expression = ls_column-expression
                          defined_in = iv_view ) INTO TABLE rt_fields.
        ENDIF.
        CONTINUE.
      ENDIF.
      IF read_view( ls_reference-entity )-found = abap_false.
        CONTINUE.
      ENDIF.

      DATA(lv_direct) = trace_field( iv_view  = ls_reference-entity
                                     iv_field = ls_reference-field
                                     iv_table = iv_table
                                     iv_depth = iv_depth + 1 ).
      IF lv_direct IS NOT INITIAL.
        INSERT VALUE #( field      = lv_direct
                        expression = ls_column-expression
                        defined_in = iv_view ) INTO TABLE rt_fields.
      ELSE.
        INSERT LINES OF trace_computed( iv_view  = ls_reference-entity
                                        iv_field = ls_reference-field
                                        iv_table = iv_table
                                        iv_depth = iv_depth + 1 ) INTO TABLE rt_fields.
      ENDIF.
    ENDLOOP.

    DATA(lt_origins) = ls_column-origins.
    IF ls_column-source_entity IS NOT INITIAL.
      INSERT VALUE #( entity = ls_column-source_entity field = ls_column-source_field ) INTO TABLE lt_origins.
    ENDIF.

    LOOP AT lt_origins INTO DATA(ls_origin).
      IF read_view( ls_origin-entity )-found = abap_true.
        INSERT LINES OF trace_computed( iv_view  = ls_origin-entity
                                        iv_field = ls_origin-field
                                        iv_table = iv_table
                                        iv_depth = iv_depth + 1 ) INTO TABLE rt_fields.
      ENDIF.
    ENDLOOP.

    SORT rt_fields BY field.
    DELETE ADJACENT DUPLICATES FROM rt_fields COMPARING field.
  ENDMETHOD.


  METHOD table_has_column.
    DATA(lv_table) = CONV tabname( iv_table ).
    READ TABLE mt_tables REFERENCE INTO DATA(lr_table) WITH TABLE KEY name = lv_table.
    IF sy-subrc <> 0.
      DATA(ls_table) = VALUE ts_table( name = lv_table ).
      SELECT FROM dd03l
        FIELDS fieldname
        WHERE tabname = @lv_table
          AND as4local = 'A'
        INTO TABLE @ls_table-columns.
      INSERT ls_table INTO TABLE mt_tables REFERENCE INTO lr_table.
    ENDIF.

    rv_found = xsdbool( line_exists( lr_table->columns[ table_line = CONV fieldname( iv_field ) ] ) ).
  ENDMETHOD.


  METHOD parse_references.
    DATA(lv_text) = to_upper( iv_expression ).
    REPLACE ALL OCCURRENCES OF PCRE `'[^']*'` IN lv_text WITH ` `.
    REPLACE ALL OCCURRENCES OF PCRE `\bAS\s+[A-Z0-9_./]+(?:\s*\([^)]*\))?` IN lv_text WITH ` `.
    REPLACE ALL OCCURRENCES OF PCRE `\bPRESERVING\s+TYPE\b` IN lv_text WITH ` `.

    FIND ALL OCCURRENCES OF PCRE `(?<![A-Z0-9_/$.])([A-Z_/][A-Z0-9_/]*)(?:\.([A-Z0-9_/]+))?\b(?!\s*\()`
         IN lv_text RESULTS DATA(lt_matches).

    LOOP AT lt_matches INTO DATA(ls_match).
      DATA(ls_first) = ls_match-submatches[ 1 ].
      DATA(ls_second) = ls_match-submatches[ 2 ].
      DATA(lv_first) = substring( val = lv_text off = ls_first-offset len = ls_first-length ).

      IF ls_second-offset < 0.
        IF iv_main IS NOT INITIAL.
          INSERT VALUE #( entity = iv_main field = lv_first ) INTO TABLE rt_refs.
        ENDIF.
        CONTINUE.
      ENDIF.

      READ TABLE it_sources INTO DATA(ls_source) WITH TABLE KEY alias = lv_first.
      IF sy-subrc = 0.
        INSERT VALUE #( entity = ls_source-entity
                        field  = substring( val = lv_text off = ls_second-offset len = ls_second-length ) )
               INTO TABLE rt_refs.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD parse_data_source.
    DATA(lv_text) = to_upper( condense( expression_text( io_source ) ) ).
    SPLIT lv_text AT ` ` INTO TABLE DATA(lt_tokens).
    DELETE lt_tokens WHERE table_line IS INITIAL
                        OR table_line = `INNER` OR table_line = `LEFT` OR table_line = `RIGHT`
                        OR table_line = `OUTER` OR table_line = `JOIN` OR table_line = `CROSS`
                        OR table_line = `TO` OR table_line = `ONE` OR table_line = `MANY`
                        OR table_line = `EXACT`.

    LOOP AT lt_tokens INTO DATA(lv_token).
      DATA(lv_index) = sy-tabix.
      IF rs_source-entity IS INITIAL.
        SPLIT lv_token AT `(` INTO rs_source-entity DATA(lv_rest).
        CONTINUE.
      ENDIF.
      IF lv_token = `AS` AND line_exists( lt_tokens[ lv_index + 1 ] ).
        rs_source-alias = lt_tokens[ lv_index + 1 ].
      ENDIF.
      EXIT.
    ENDLOOP.
  ENDMETHOD.


  METHOD parse_column.
    DATA(lv_text) = to_upper( condense( iv_expression ) ).

    FIND FIRST OCCURRENCE OF PCRE `^(?:CAST\s*\(\s*)+([A-Z0-9_/$.]+)\s+AS\s` IN lv_text SUBMATCHES DATA(lv_cast_inner).
    IF sy-subrc = 0.
      lv_text = lv_cast_inner.
    ENDIF.

    FIND FIRST OCCURRENCE OF PCRE `^[A-Z0-9_/$]+(\.[A-Z0-9_/$]+)?$` IN lv_text.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    IF lv_text CS `.`.
      SPLIT lv_text AT `.` INTO DATA(lv_qualifier) DATA(lv_field).
      READ TABLE it_sources INTO DATA(ls_source) WITH TABLE KEY alias = lv_qualifier.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.
      rs_column-source_entity = ls_source-entity.
      rs_column-source_field = lv_field.
    ELSE.
      rs_column-source_entity = iv_main.
      rs_column-source_field = lv_text.
    ENDIF.
  ENDMETHOD.


  METHOD expression_text.
    IF io_expression IS NOT BOUND.
      RETURN.
    ENDIF.
    rv_text = concat_lines_of( table = io_expression->if_xco_text~get_lines( )->value
                               sep   = ` ` ).
  ENDMETHOD.

ENDCLASS.


CLASS lcl_report DEFINITION FINAL.
  PUBLIC SECTION.
    METHODS run.

  PRIVATE SECTION.
    TYPES: BEGIN OF ts_row,
             table_name  TYPE tabname,
             table_field TYPE fieldname,
             cds_view    TYPE ddlname,
             cds_field   TYPE fieldname,
             match_type  TYPE c LENGTH 13,
             how_to_use  TYPE c LENGTH 10,
             release     TYPE c LENGTH 12,
             covered     TYPE i,
             expression  TYPE string,
             defined_in  TYPE string,
           END OF ts_row,
           tt_row   TYPE STANDARD TABLE OF ts_row WITH EMPTY KEY,
           tt_field TYPE STANDARD TABLE OF fieldname WITH EMPTY KEY.

    TYPES: BEGIN OF ts_key,
             position     TYPE i,
             field_name   TYPE fieldname,
             data_element TYPE rollname,
             description  TYPE as4text,
             data_type    TYPE datatype_d,
             length       TYPE ddleng,
           END OF ts_key,
           tt_key TYPE STANDARD TABLE OF ts_key WITH EMPTY KEY.

    TYPES: BEGIN OF ts_successor,
             object_type    TYPE c LENGTH 10,
             object_name    TYPE string,
             object_state   TYPE c LENGTH 30,
             successor_type TYPE c LENGTH 10,
             successor_name TYPE string,
             abap_cloud     TYPE c LENGTH 13,
           END OF ts_successor,
           tt_successor TYPE STANDARD TABLE OF ts_successor WITH EMPTY KEY.

    TYPES: BEGIN OF ts_api_key,
             object_type     TYPE ars_w_api_state-object_type,
             object_id       TYPE ars_w_api_state-object_id,
             sub_object_name TYPE ars_w_api_state-sub_object_name,
           END OF ts_api_key,
           tt_api_key TYPE SORTED TABLE OF ts_api_key WITH UNIQUE KEY object_type object_id sub_object_name.

    TYPES: BEGIN OF ts_api_state,
             object_type     TYPE ars_w_api_state-object_type,
             object_id       TYPE ars_w_api_state-object_id,
             sub_object_name TYPE ars_w_api_state-sub_object_name,
             release_state   TYPE ars_w_api_state-release_state,
             cloud           TYPE ars_w_api_state-use_in_sap_cloud_platform,
           END OF ts_api_state,
           tt_api_state TYPE SORTED TABLE OF ts_api_state
                        WITH NON-UNIQUE KEY object_type object_id sub_object_name.

    TYPES tt_name_range TYPE RANGE OF ars_w_api_sccssr-sub_object_name.

    TYPES: BEGIN OF ts_export,
             release    TYPE string,
             pairs_from TYPE string,
             tables     TYPE lcl_mapping=>tt_view_map,
             successors TYPE tt_successor,
           END OF ts_export.

    CONSTANTS: c_same_column   TYPE c LENGTH 13 VALUE 'Same column',
               c_in_expression TYPE c LENGTH 13 VALUE 'In expression',
               c_released      TYPE c LENGTH 13 VALUE 'Released',
               c_key_user_only TYPE c LENGTH 13 VALUE 'Key user only',
               c_not_released  TYPE c LENGTH 13 VALUE 'Not released'.

    DATA mt_rows       TYPE tt_row.
    DATA mt_keys       TYPE tt_key.
    DATA mt_successors TYPE tt_successor.
    DATA mv_note       TYPE string.
    DATA mv_source     TYPE string.
    DATA mo_extractor  TYPE REF TO lcl_mapping.

    METHODS all_pairs
      RETURNING VALUE(rt_pairs) TYPE lcl_pairs=>tt_pair.

    METHODS read_states
      IMPORTING it_keys          TYPE tt_api_key
      RETURNING VALUE(rt_states) TYPE tt_api_state.

    METHODS availability
      IMPORTING is_state       TYPE ts_api_state
      RETURNING VALUE(rv_text) TYPE ts_successor-abap_cloud.

    METHODS show_objects.

    METHODS read_successors
      IMPORTING it_names       TYPE tt_name_range
      RETURNING VALUE(rt_rows) TYPE tt_successor.

    METHODS explain_missing
      IMPORTING it_names TYPE tt_name_range.

    METHODS show_successors.

    METHODS system_release
      RETURNING VALUE(rv_release) TYPE string.

    METHODS selected_pairs
      RETURNING VALUE(rt_pairs) TYPE lcl_pairs=>tt_pair.

    METHODS extract_pairs
      IMPORTING it_pairs         TYPE lcl_pairs=>tt_pair
      RETURNING VALUE(rt_result) TYPE lcl_mapping=>tt_view_map.

    METHODS fill_rows
      IMPORTING it_result TYPE lcl_mapping=>tt_view_map.

    METHODS requested_fields
      RETURNING VALUE(rt_fields) TYPE tt_field.

    METHODS add_coverage
      IMPORTING it_fields TYPE tt_field.

    METHODS show_rows.

    METHODS on_link_click FOR EVENT link_click OF cl_salv_events_table
      IMPORTING row column.

    METHODS read_table_keys
      IMPORTING iv_table TYPE tabname.

    METHODS read_view_keys
      IMPORTING iv_view TYPE ddlname.

    METHODS show_keys
      IMPORTING iv_name TYPE string.

    METHODS show_definition
      IMPORTING is_row TYPE ts_row.

    METHODS highlight
      IMPORTING iv_line       TYPE string
      RETURNING VALUE(rv_html) TYPE string.

    METHODS set_heading
      IMPORTING io_columns TYPE REF TO cl_salv_columns_table
                iv_column  TYPE lvc_fname
                iv_text    TYPE scrtext_s
      RAISING   cx_salv_not_found.

    METHODS download_all.

    METHODS choose_file
      IMPORTING iv_default     TYPE string
      RETURNING VALUE(rv_file) TYPE string.

    METHODS download
      IMPORTING iv_json    TYPE string
                iv_file    TYPE string
                iv_written TYPE string.
ENDCLASS.


CLASS lcl_report IMPLEMENTATION.
  METHOD run.
    IF p_json = abap_true.
      download_all( ).
      RETURN.
    ENDIF.

    IF p_obj = abap_true.
      show_objects( ).
      RETURN.
    ENDIF.

    IF p_cds IS NOT INITIAL AND p_table IS INITIAL.
      MESSAGE 'Enter the table the CDS view replaces' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
    IF s_field[] IS NOT INITIAL AND p_table IS INITIAL.
      MESSAGE 'Enter the table the fields belong to' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    DATA(lt_pairs) = selected_pairs( ).
    IF lt_pairs IS INITIAL.
      MESSAGE |No successor CDS view listed for { p_table }. Enter one in the CDS view field.|
              TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    mo_extractor = NEW #( ).
    fill_rows( extract_pairs( lt_pairs ) ).
    show_rows( ).
  ENDMETHOD.


  METHOD download_all.
    DATA(lv_file) = choose_file( `core-data-services.json` ).
    IF lv_file IS INITIAL.
      RETURN.
    ENDIF.

    mo_extractor = NEW #( ).
    DATA(ls_export) = VALUE ts_export( release    = system_release( )
                                       tables     = extract_pairs( all_pairs( ) )
                                       successors = read_successors( VALUE #( ) ) ).
    ls_export-pairs_from = mv_source.

    download( iv_json    = /ui2/cl_json=>serialize( data        = ls_export
                                                    pretty_name = /ui2/cl_json=>pretty_mode-camel_case )
              iv_file    = lv_file
              iv_written = |{ lines( ls_export-tables ) } views and { lines( ls_export-successors ) } successors| ).
  ENDMETHOD.


  METHOD system_release.
    SELECT FROM cvers
      FIELDS component, release, extrelease
      WHERE component IN ( 'S4CORE', 'SAP_BASIS' )
      INTO TABLE @DATA(lt_components).

    DATA(ls_component) = VALUE #( lt_components[ component = 'S4CORE' ]
                                  DEFAULT VALUE #( lt_components[ component = 'SAP_BASIS' ] OPTIONAL ) ).
    rv_release = |{ ls_component-component } { ls_component-release } SP{ ls_component-extrelease ALPHA = OUT }|.
  ENDMETHOD.


  METHOD all_pairs.
    SELECT FROM ars_w_api_sccssr
      FIELDS object_id, successor_object_name
      WHERE object_type            = 'TABL'
        AND successor_object_type  = 'DDLS'
        AND compatibility_contract = 'C1'
      INTO TABLE @DATA(lt_successors).
    IF lt_successors IS INITIAL.
      mv_source = `the built-in list`.
      rt_pairs = lcl_pairs=>get( ).
      RETURN.
    ENDIF.

    mv_source = `this system`.
    DATA(lt_keys) = VALUE tt_api_key( ).
    LOOP AT lt_successors INTO DATA(ls_successor).
      INSERT VALUE #( object_type     = 'DDLS'
                      object_id       = ls_successor-successor_object_name
                      sub_object_name = ls_successor-successor_object_name ) INTO TABLE lt_keys.
    ENDLOOP.
    DATA(lt_states) = read_states( lt_keys ).

    LOOP AT lt_successors INTO ls_successor.
      DATA(ls_state) = VALUE #( lt_states[ object_type     = 'DDLS'
                                           object_id       = ls_successor-successor_object_name
                                           sub_object_name = ls_successor-successor_object_name ] OPTIONAL ).
      INSERT VALUE #( table_name = ls_successor-object_id
                      cds_name   = ls_successor-successor_object_name
                      released   = xsdbool( availability( ls_state ) = c_released ) )
             INTO TABLE rt_pairs.
    ENDLOOP.
    SORT rt_pairs BY table_name cds_name.
    DELETE ADJACENT DUPLICATES FROM rt_pairs COMPARING table_name cds_name.
  ENDMETHOD.


  METHOD read_states.
    IF it_keys IS INITIAL.
      RETURN.
    ENDIF.

    SELECT FROM @it_keys AS api_key
      INNER JOIN ars_w_api_state AS state
        ON  state~object_type     = api_key~object_type
        AND state~object_id       = api_key~object_id
        AND state~sub_object_name = api_key~sub_object_name
      FIELDS state~object_type, state~object_id, state~sub_object_name,
             state~release_state,
             state~use_in_sap_cloud_platform AS cloud
      WHERE state~compatibility_contract = 'C1'
      INTO CORRESPONDING FIELDS OF TABLE @rt_states.
  ENDMETHOD.


  METHOD availability.
    rv_text = COND #( WHEN is_state-release_state = 'RELEASED' AND is_state-cloud = abap_true
                        THEN c_released
                      WHEN is_state-release_state = 'RELEASED'
                        THEN c_key_user_only
                      ELSE c_not_released ).
  ENDMETHOD.


  METHOD show_objects.
    IF p_oname IS INITIAL.
      MESSAGE 'Enter an object name' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    DATA(lv_name) = to_upper( condense( p_oname ) ).
    DATA(lt_names) = VALUE tt_name_range( ( sign   = 'I'
                                            option = COND #( WHEN lv_name CA '*+' THEN 'CP' ELSE 'EQ' )
                                            low    = lv_name ) ).
    mt_successors = read_successors( lt_names ).
    IF p_otype IS NOT INITIAL.
      DELETE mt_successors WHERE object_type <> p_otype.
    ENDIF.

    IF mt_successors IS INITIAL.
      explain_missing( lt_names ).
      RETURN.
    ENDIF.
    show_successors( ).
  ENDMETHOD.


  METHOD read_successors.
    SELECT FROM ars_w_api_sccssr
      FIELDS object_type, object_id, sub_object_type, sub_object_name,
             successor_object_type, successor_object_name,
             successor_sub_object_type, successor_sub_object_name
      WHERE compatibility_contract = 'C1'
        AND ( object_id IN @it_names OR sub_object_name IN @it_names )
      INTO TABLE @DATA(lt_links).
    IF lt_links IS INITIAL.
      RETURN.
    ENDIF.

    DATA(lt_keys) = VALUE tt_api_key( ).
    LOOP AT lt_links INTO DATA(ls_link).
      INSERT VALUE #( object_type     = ls_link-object_type
                      object_id       = ls_link-object_id
                      sub_object_name = ls_link-sub_object_name ) INTO TABLE lt_keys.
      INSERT VALUE #( object_type     = ls_link-successor_object_type
                      object_id       = ls_link-successor_object_name
                      sub_object_name = ls_link-successor_sub_object_name ) INTO TABLE lt_keys.
    ENDLOOP.
    DATA(lt_states) = read_states( lt_keys ).

    LOOP AT lt_links INTO ls_link.
      DATA(ls_source) = VALUE #( lt_states[ object_type     = ls_link-object_type
                                            object_id       = ls_link-object_id
                                            sub_object_name = ls_link-sub_object_name ] OPTIONAL ).
      DATA(ls_target) = VALUE #( lt_states[ object_type     = ls_link-successor_object_type
                                            object_id       = ls_link-successor_object_name
                                            sub_object_name = ls_link-successor_sub_object_name ] OPTIONAL ).
      INSERT VALUE #( object_type    = COND #( WHEN ls_link-sub_object_type = 'CDS_STOB' OR ls_link-sub_object_type IS INITIAL
                                                 THEN ls_link-object_type
                                               ELSE ls_link-sub_object_type )
                      object_name    = COND #( WHEN ls_link-sub_object_name IS INITIAL
                                                 THEN ls_link-object_id
                                               ELSE ls_link-sub_object_name )
                      object_state   = COND #( WHEN ls_source-release_state IS INITIAL
                                                 THEN 'NO ENTRY'
                                               ELSE ls_source-release_state )
                      successor_type = COND #( WHEN ls_link-successor_sub_object_type = 'CDS_STOB'
                                                 OR ls_link-successor_sub_object_type IS INITIAL
                                                 THEN ls_link-successor_object_type
                                               ELSE ls_link-successor_sub_object_type )
                      successor_name = COND #( WHEN ls_link-successor_sub_object_name IS INITIAL
                                                 THEN ls_link-successor_object_name
                                               ELSE ls_link-successor_sub_object_name )
                      abap_cloud     = availability( ls_target ) )
             INTO TABLE rt_rows.
    ENDLOOP.
    SORT rt_rows BY object_type object_name successor_name.
  ENDMETHOD.


  METHOD explain_missing.
    SELECT SINGLE FROM ars_w_api_sccssr
      FIELDS object_id
      WHERE compatibility_contract = 'C1'
      INTO @DATA(lv_any).
    IF sy-subrc <> 0.
      MESSAGE 'This system has no successor list (it needs S/4HANA 2022 or later). See SAP''s objectReleaseInfo_PCELatest.json.'
              TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    SELECT FROM ars_w_api_state
      FIELDS release_state, use_in_sap_cloud_platform AS cloud
      WHERE compatibility_contract = 'C1'
        AND ( object_id IN @it_names OR sub_object_name IN @it_names )
      INTO TABLE @DATA(lt_found).

    DATA(lv_name) = condense( p_oname ).
    IF line_exists( lt_found[ release_state = 'RELEASED' cloud = abap_true ] ).
      MESSAGE |{ lv_name } is released for ABAP Cloud. No successor is needed.| TYPE 'S'.
    ELSEIF lt_found IS INITIAL.
      MESSAGE |{ lv_name } is not in this system's API list, and SAP names no successor for it.|
              TYPE 'S' DISPLAY LIKE 'E'.
    ELSE.
      MESSAGE |{ lv_name } ({ lt_found[ 1 ]-release_state }): SAP names no successor object for it.|
              TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.
  ENDMETHOD.


  METHOD show_successors.
    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_alv)
                                CHANGING  t_table      = mt_successors ).
        lo_alv->get_functions( )->set_all( ).
        lo_alv->get_display_settings( )->set_list_header(
          CONV #( |Successors of { condense( p_oname ) }, read from this system| ) ).

        DATA(lo_columns) = lo_alv->get_columns( ).
        lo_columns->set_optimize( ).
        set_heading( io_columns = lo_columns iv_column = 'OBJECT_TYPE'    iv_text = 'Type' ).
        set_heading( io_columns = lo_columns iv_column = 'OBJECT_NAME'    iv_text = 'Object' ).
        set_heading( io_columns = lo_columns iv_column = 'OBJECT_STATE'   iv_text = 'State' ).
        set_heading( io_columns = lo_columns iv_column = 'SUCCESSOR_TYPE' iv_text = 'Succ. type' ).
        set_heading( io_columns = lo_columns iv_column = 'SUCCESSOR_NAME' iv_text = 'Successor' ).
        set_heading( io_columns = lo_columns iv_column = 'ABAP_CLOUD'     iv_text = 'ABAP Cloud' ).
        lo_alv->display( ).
      CATCH cx_salv_error INTO DATA(lx_error).
        MESSAGE lx_error TYPE 'S' DISPLAY LIKE 'E'.
    ENDTRY.
  ENDMETHOD.


  METHOD extract_pairs.
    DATA(lv_total) = lines( it_pairs ).

    LOOP AT it_pairs INTO DATA(ls_pair).
      DATA(lv_done) = sy-tabix.
      cl_progress_indicator=>progress_indicate(
        i_text               = |{ lv_done }/{ lv_total } { ls_pair-cds_name }|
        i_processed          = lv_done
        i_total              = lv_total
        i_output_immediately = abap_true ).
      INSERT LINES OF mo_extractor->extract( VALUE #( ( ls_pair ) ) ) INTO TABLE rt_result.
    ENDLOOP.
  ENDMETHOD.


  METHOD selected_pairs.
    DATA(lt_all) = all_pairs( ).
    DATA(lv_table) = to_upper( p_table ).

    IF p_cds IS NOT INITIAL.
      DATA(lv_cds) = to_upper( p_cds ).
      DATA(lv_released) = VALUE #( lt_all[ cds_name = lv_cds ]-released DEFAULT abap_true ).
      IF mv_source = `this system`.
        DATA(lt_states) = read_states( VALUE #( ( object_type     = 'DDLS'
                                                  object_id       = lv_cds
                                                  sub_object_name = lv_cds ) ) ).
        lv_released = xsdbool( availability( VALUE #( lt_states[ 1 ] OPTIONAL ) ) = c_released ).
      ENDIF.
      rt_pairs = VALUE #( ( table_name = lv_table
                            cds_name   = lv_cds
                            released   = lv_released ) ).
      RETURN.
    ENDIF.

    rt_pairs = lt_all.
    IF lv_table IS NOT INITIAL.
      DELETE rt_pairs WHERE table_name <> lv_table.
    ENDIF.
  ENDMETHOD.


  METHOD fill_rows.
    LOOP AT it_result INTO DATA(ls_view).
      LOOP AT ls_view-mapping INTO DATA(ls_map).
        IF ls_map-table_field IS INITIAL.
          CONTINUE.
        ENDIF.
        DATA(lv_table_field) = CONV fieldname( to_upper( ls_map-table_field ) ).
        IF lv_table_field NOT IN s_field.
          CONTINUE.
        ENDIF.
        INSERT VALUE #( table_name  = ls_view-table_name
                        table_field = lv_table_field
                        cds_view    = ls_view-cds_name
                        cds_field   = ls_map-cds_field
                        match_type  = COND #( WHEN ls_map-computed = abap_true       THEN c_in_expression
                                              WHEN ls_map-table_field IS NOT INITIAL THEN c_same_column )
                        how_to_use  = COND #( WHEN ls_map-computed = abap_true THEN 'Show' )
                        release     = COND #( WHEN ls_view-released = abap_false THEN 'Not released' )
                        expression  = ls_map-expression
                        defined_in  = ls_map-defined_in )
               INTO TABLE mt_rows.
      ENDLOOP.
    ENDLOOP.

    IF s_field[] IS NOT INITIAL.
      add_coverage( requested_fields( ) ).
      RETURN.
    ENDIF.

    SORT mt_rows BY table_name table_field cds_view cds_field.
  ENDMETHOD.


  METHOD requested_fields.
    SELECT FROM dd03l
      FIELDS fieldname
      WHERE tabname = @p_table
        AND as4local = 'A'
        AND fieldname IN @s_field
        AND fieldname NOT LIKE '.%'
        AND fieldname <> 'MANDT'
      INTO TABLE @rt_fields.

    LOOP AT s_field INTO DATA(ls_field) WHERE sign = 'I' AND option = 'EQ'.
      INSERT ls_field-low INTO TABLE rt_fields.
    ENDLOOP.

    SORT rt_fields BY table_line.
    DELETE ADJACENT DUPLICATES FROM rt_fields COMPARING table_line.
  ENDMETHOD.


  METHOD add_coverage.
    DATA(lt_view_fields) = mt_rows.
    DELETE lt_view_fields WHERE match_type <> c_same_column.
    SORT lt_view_fields BY cds_view table_field.
    DELETE ADJACENT DUPLICATES FROM lt_view_fields COMPARING cds_view table_field.

    DATA(lv_total) = lines( it_fields ).
    LOOP AT mt_rows ASSIGNING FIELD-SYMBOL(<ls_row>).
      <ls_row>-covered = REDUCE i( INIT lv_count = 0
                                   FOR ls_view_field IN lt_view_fields
                                   WHERE ( cds_view = <ls_row>-cds_view )
                                   NEXT lv_count = lv_count + 1 ).
    ENDLOOP.

    LOOP AT it_fields INTO DATA(lv_field).
      IF NOT line_exists( mt_rows[ table_field = lv_field ] ).
        INSERT VALUE #( table_name = p_table table_field = lv_field ) INTO TABLE mt_rows.
      ENDIF.
    ENDLOOP.

    SORT mt_rows BY covered DESCENDING cds_view table_field cds_field.

    DATA(ls_best) = VALUE #( mt_rows[ 1 ] OPTIONAL ).
    mv_note = COND #( WHEN ls_best-covered = 0
                        THEN `No listed view reads these fields directly`
                      WHEN ls_best-covered = lv_total
                        THEN |{ ls_best-cds_view } covers all { lv_total } fields directly|
                      ELSE `No single view reads all fields directly` ).
  ENDMETHOD.


  METHOD show_rows.
    IF mt_rows IS INITIAL.
      MESSAGE 'No field could be traced to a table column.' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    DATA(lt_errors) = mo_extractor->get_errors( ).
    IF lt_errors IS NOT INITIAL.
      MESSAGE |{ lines( lt_errors ) } views skipped, first: { lt_errors[ 1 ] }| TYPE 'S'.
    ENDIF.

    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_alv)
                                CHANGING  t_table      = mt_rows ).
        lo_alv->get_functions( )->set_all( ).
        lo_alv->get_display_settings( )->set_list_header(
          CONV #( COND string( WHEN mv_note IS INITIAL THEN |Pairs from { mv_source }|
                               ELSE |{ mv_note }. Pairs from { mv_source }| ) ) ).

        DATA(lo_columns) = lo_alv->get_columns( ).
        lo_columns->set_optimize( ).
        set_heading( io_columns = lo_columns iv_column = 'TABLE_NAME'  iv_text = 'Table' ).
        set_heading( io_columns = lo_columns iv_column = 'TABLE_FIELD' iv_text = 'Table fld' ).
        set_heading( io_columns = lo_columns iv_column = 'CDS_VIEW'    iv_text = 'CDS view' ).
        set_heading( io_columns = lo_columns iv_column = 'CDS_FIELD'   iv_text = 'CDS field' ).
        set_heading( io_columns = lo_columns iv_column = 'MATCH_TYPE'  iv_text = 'Match' ).
        set_heading( io_columns = lo_columns iv_column = 'HOW_TO_USE'  iv_text = 'How to use' ).
        set_heading( io_columns = lo_columns iv_column = 'RELEASE'     iv_text = 'Release' ).
        lo_columns->get_column( 'RELEASE' )->set_visible(
          xsdbool( line_exists( mt_rows[ release = 'Not released' ] ) ) ).
        lo_columns->get_column( 'COVERED' )->set_technical( ).
        lo_columns->get_column( 'EXPRESSION' )->set_technical( ).
        lo_columns->get_column( 'DEFINED_IN' )->set_technical( ).
        CAST cl_salv_column_table( lo_columns->get_column( 'HOW_TO_USE' )
          )->set_cell_type( if_salv_c_cell_type=>hotspot ).
        CAST cl_salv_column_table( lo_columns->get_column( 'TABLE_NAME' )
          )->set_cell_type( if_salv_c_cell_type=>hotspot ).
        CAST cl_salv_column_table( lo_columns->get_column( 'CDS_VIEW' )
          )->set_cell_type( if_salv_c_cell_type=>hotspot ).

        DATA(lo_events) = lo_alv->get_event( ).
        SET HANDLER on_link_click FOR lo_events.

        lo_alv->display( ).
      CATCH cx_salv_error INTO DATA(lx_error).
        MESSAGE lx_error TYPE 'S' DISPLAY LIKE 'E'.
    ENDTRY.
  ENDMETHOD.


  METHOD on_link_click.
    DATA(ls_row) = VALUE ts_row( mt_rows[ row ] OPTIONAL ).

    CASE column.
      WHEN 'TABLE_NAME'.
        read_table_keys( ls_row-table_name ).
        show_keys( |{ ls_row-table_name }| ).
      WHEN 'CDS_VIEW'.
        IF ls_row-cds_view IS INITIAL.
          RETURN.
        ENDIF.
        read_view_keys( ls_row-cds_view ).
        show_keys( |{ ls_row-cds_view }| ).
      WHEN 'HOW_TO_USE'.
        IF ls_row-how_to_use IS NOT INITIAL.
          show_definition( ls_row ).
        ENDIF.
    ENDCASE.
  ENDMETHOD.


  METHOD show_definition.
    DATA(lv_text) = condense( is_row-expression ).
    IF lv_text IS INITIAL.
      MESSAGE 'The definition could not be read. Open the view in ADT.' TYPE 'S'.
      RETURN.
    ENDIF.

    REPLACE ALL OCCURRENCES OF PCRE `(?i)\s+(?=(?:when|else|end)\b)` IN lv_text WITH cl_abap_char_utilities=>newline.
    SPLIT lv_text AT cl_abap_char_utilities=>newline INTO TABLE DATA(lt_lines).
    DATA(lv_last) = lines( lt_lines ).
    lt_lines[ lv_last ] = |{ lt_lines[ lv_last ] } as { is_row-cds_field }|.

    DATA(lv_rows) = ``.
    LOOP AT lt_lines INTO DATA(lv_line).
      DATA(lv_number) = sy-tabix.
      DATA(lv_indent) = COND string( WHEN lv_line CP 'when *' OR lv_line CP 'else *' THEN `  ` ).
      lv_rows = |{ lv_rows }<tr><td class="n">{ lv_number }</td><td class="c">{ lv_indent }{ highlight( lv_line ) }</td></tr>|.
    ENDLOOP.

    DATA(lv_title) = |{ is_row-cds_field } in { is_row-defined_in } [{ sy-sysid }, { sy-mandt }]|.
    DATA(lv_style) = `<style>`
      && `body{margin:0;font-family:Consolas,'Courier New',monospace;font-size:13px;background:#fff}`
      && `h1{margin:0;padding:6px 8px;font:bold 15px Arial,sans-serif;border-bottom:3px solid #999}`
      && `table{border-collapse:collapse;margin:4px 0;width:100%}`
      && `.n{width:1%;padding:1px 8px;text-align:right;vertical-align:top;color:#888;background:#f0f0f0;border-right:1px solid #ccc}`
      && `.c{padding:1px 8px;white-space:pre-wrap;word-wrap:break-word;word-break:break-word}`
      && `b{color:#7f0055}i{color:#2a00ff;font-style:normal}`
      && `</style>`.

    cl_abap_browser=>show_html(
      title       = CONV #( lv_title )
      html_string = |<html><head><meta charset="utf-8">{ lv_style }</head><body>|
                 && |<h1>{ escape( val = lv_title format = cl_abap_format=>e_html_text ) }</h1>|
                 && |<table>{ lv_rows }</table></body></html>|
      check_html  = abap_false ).
  ENDMETHOD.


  METHOD highlight.
    rv_html = escape( val = iv_line format = cl_abap_format=>e_html_text ).
    REPLACE ALL OCCURRENCES OF PCRE `(?i)\b(?:case|when|then|else|end|cast|as|preserving|type|and|or|not|is|null)\b`
            IN rv_html WITH `<b>$0</b>`.
    REPLACE ALL OCCURRENCES OF PCRE `'[^']*'` IN rv_html WITH `<i>$0</i>`.
  ENDMETHOD.


  METHOD read_table_keys.
    SELECT FROM dd03l AS field
      LEFT OUTER JOIN dd04t AS text
        ON  text~rollname   = field~rollname
        AND text~ddlanguage = @sy-langu
        AND text~as4local   = 'A'
        AND text~as4vers    = '0000'
      FIELDS CAST( field~position AS INT4 ) AS position,
             field~fieldname AS field_name,
             field~rollname  AS data_element,
             text~ddtext     AS description,
             field~datatype  AS data_type,
             field~leng      AS length
      WHERE field~tabname  = @iv_table
        AND field~as4local = 'A'
        AND field~keyflag  = 'X'
        AND field~datatype <> 'CLNT'
        AND field~fieldname NOT LIKE '.%'
      INTO CORRESPONDING FIELDS OF TABLE @mt_keys.
    SORT mt_keys BY position.
  ENDMETHOD.


  METHOD read_view_keys.
    SELECT FROM dd03nd AS field
      LEFT OUTER JOIN dd04t AS text
        ON  text~rollname   = field~rollname
        AND text~ddlanguage = @sy-langu
        AND text~as4local   = 'A'
        AND text~as4vers    = '0000'
      FIELDS field~position,
             field~fieldname_raw AS field_name,
             field~rollname      AS data_element,
             text~ddtext         AS description,
             field~datatype      AS data_type,
             field~leng          AS length
      WHERE field~strucobjn = @iv_view
        AND field~as4local  = 'A'
        AND field~keyflag   = 'X'
        AND field~datatype <> 'CLNT'
      INTO CORRESPONDING FIELDS OF TABLE @mt_keys.
    SORT mt_keys BY position.
  ENDMETHOD.


  METHOD show_keys.
    IF mt_keys IS INITIAL.
      MESSAGE |No key fields found for { iv_name }| TYPE 'S'.
      RETURN.
    ENDIF.

    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_popup)
                                CHANGING  t_table      = mt_keys ).
        lo_popup->get_display_settings( )->set_list_header( CONV #( |Key fields of { iv_name }| ) ).

        DATA(lo_columns) = lo_popup->get_columns( ).
        lo_columns->set_optimize( ).
        lo_columns->get_column( 'POSITION' )->set_technical( ).
        set_heading( io_columns = lo_columns iv_column = 'FIELD_NAME'   iv_text = 'Key field' ).
        set_heading( io_columns = lo_columns iv_column = 'DATA_ELEMENT' iv_text = 'Data elem' ).
        set_heading( io_columns = lo_columns iv_column = 'DESCRIPTION'  iv_text = 'Descript.' ).
        set_heading( io_columns = lo_columns iv_column = 'DATA_TYPE'    iv_text = 'Type' ).
        set_heading( io_columns = lo_columns iv_column = 'LENGTH'       iv_text = 'Length' ).

        lo_popup->set_screen_popup( start_column = 10 end_column  = 110
                                    start_line   = 5  end_line    = 20 ).
        lo_popup->display( ).
      CATCH cx_salv_error INTO DATA(lx_error).
        MESSAGE lx_error TYPE 'S' DISPLAY LIKE 'E'.
    ENDTRY.
  ENDMETHOD.


  METHOD set_heading.
    DATA(lo_column) = io_columns->get_column( iv_column ).
    lo_column->set_short_text( iv_text ).
    lo_column->set_medium_text( CONV #( iv_text ) ).
    lo_column->set_long_text( CONV #( iv_text ) ).
  ENDMETHOD.


  METHOD download.
    DATA(lv_content) = cl_abap_codepage=>convert_to( iv_json ).
    DATA(lt_binary) = cl_bcs_convert=>xstring_to_solix( lv_content ).

    cl_gui_frontend_services=>gui_download(
      EXPORTING bin_filesize = xstrlen( lv_content )
                filename     = iv_file
                filetype     = 'BIN'
      CHANGING  data_tab     = lt_binary
      EXCEPTIONS OTHERS      = 1 ).
    IF sy-subrc <> 0.
      MESSAGE |Download failed: { iv_file }| TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    MESSAGE |{ iv_written } written to { iv_file }| TYPE 'S'.
  ENDMETHOD.


  METHOD choose_file.
    DATA lv_filename TYPE string.
    DATA lv_path     TYPE string.
    DATA lv_fullpath TYPE string.

    cl_gui_frontend_services=>file_save_dialog(
      EXPORTING default_file_name = iv_default
                default_extension = `json`
      CHANGING  filename          = lv_filename
                path              = lv_path
                fullpath          = lv_fullpath
      EXCEPTIONS OTHERS           = 1 ).
    IF sy-subrc = 0.
      rv_file = lv_fullpath.
    ENDIF.
  ENDMETHOD.
ENDCLASS.


INITIALIZATION.
  %_p_alv_%_app_%-text = 'Show on screen'.
  %_p_cds_%_app_%-text = 'CDS view'.
  %_p_obj_%_app_%-text = 'Other objects'.
  %_p_oname_%_app_%-text = 'Object name'.
  %_p_otype_%_app_%-text = 'Object type'.
  %_p_json_%_app_%-text = 'Download JSON'.
  %_p_tab_%_app_%-text = 'Table fields to CDS'.
  %_p_table_%_app_%-text = 'Table'.
  %_s_field_%_app_%-text = 'Table fields'.

AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    IF ( screen-group1 = 'TAB' AND ( p_obj = abap_true OR p_json = abap_true ) )
    OR ( screen-group1 = 'OBJ' AND ( p_tab = abap_true OR p_json = abap_true ) )
    OR ( screen-group1 = 'WHT' AND p_json = abap_true ).
      screen-active = '0'.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.

START-OF-SELECTION.
  NEW lcl_report( )->run( ).
