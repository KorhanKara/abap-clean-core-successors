        READ TABLE rs_view-columns ASSIGNING FIELD-SYMBOL(<ls_computed>) WITH TABLE KEY field = lv_computed.
        <ls_computed>-computed = ls_parsed_column-computed.
        <ls_computed>-expression = ls_parsed_column-expression.
